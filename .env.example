VITE_API_MODE=mock
VITE_API_BASE_URL=http://localhost:4000
# Next.js uses the public aliases below. Keep them aligned with the Vite keys
# while the route shell is being migrated incrementally.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:4000
# MSW is enabled by default in mock mode. Set either public key to false only
# when intentionally exercising the API without the browser mock worker.
VITE_ENABLE_MSW=true
NEXT_PUBLIC_ENABLE_MSW=true
# Set true in CI when an unhandled /api request must fail the browser suite.
VITE_MSW_STRICT=false
NEXT_PUBLIC_MSW_STRICT=false
# Deployment capability profile. `ru` hides providers unavailable for the
# Russian deployment (for example Google sign-in); `global` enables all
# providers configured for that deployment.
VITE_DEPLOYMENT_MARKET=ru
# Keep provider pricing hidden during the free MVP launch. Set true only after
# the monetization release gate is approved.
VITE_ENABLE_PROVIDER_PRICING=false
# Chat is enabled for the MVP. Set either public key to false only for a
# constrained rollout while keeping the routes/API available for development.
VITE_ENABLE_CHAT_NAVIGATION=true
NEXT_PUBLIC_ENABLE_CHAT_NAVIGATION=true
# VITE_API_MODE=real
