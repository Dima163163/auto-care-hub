{
  "name": "autocare-hub-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API for AutoCare Hub.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "npm run start:server",
    "start:server": "node dist/server.js",
    "start:with-migrations": "npm run migration:run && npm run start:server",
    "start:render": "npm run start:server",
    "stripe:listen": "stripe listen --forward-to localhost:4000/webhooks/stripe",
    "check:docker": "node scripts/check-docker.mjs",
    "db:up": "npm run check:docker && docker compose up -d",
    "db:down": "npm run check:docker && docker compose down",
    "db:ps": "npm run check:docker && docker compose ps",
    "db:backup": "./scripts/backup.sh",
    "db:restore": "./scripts/restore.sh",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "release:migrate": "npm run migration:run",
    "schema:check": "tsx src/scripts/check-schema-contract.ts",
    "migration:run": "npm run typeorm migration:run -- -d src/database/data-source.ts",
    "migration:smoke": "npm run migration:run && npm run migration:run && npm run typeorm migration:show -- -d src/database/data-source.ts",
    "check:migrations": "node ../scripts/check-migration-order.mjs src/database/migrations",
    "migration:revert": "npm run typeorm migration:revert -- -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm migration:generate -- -d src/database/data-source.ts",
    "migration:create": "npm run typeorm migration:create",
    "demo:seed": "tsx src/scripts/seed-demo-data.ts",
    "autocare:seed": "tsx src/scripts/seed-autocare-mock-data.ts",
    "demo:reset": "tsx src/scripts/reset-demo-data.ts",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:integration-prerequisites": "node ../scripts/check-integration-prerequisites.mjs",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/websocket": "^11.3.0",
    "@stripe/react-stripe-js": "^6.7.0",
    "@stripe/stripe-js": "^9.9.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.11",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.3",
    "stripe": "^22.3.1",
    "typeorm": "^0.3.30",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fastify/session": "^11.1.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.8.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.8",
    "fastify-tsconfig": "^3.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8",
    "vitest-tsconfig-paths": "^3.4.1"
  }
}
