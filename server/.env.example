NODE_ENV=development
RUNTIME_MODE=all

PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
# Keep both loopback hostnames when the dev server falls back to Vite port 5178.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5178,http://127.0.0.1:5178,http://localhost:4175,http://127.0.0.1:4175
FRONTEND_ORIGIN=http://localhost:5173

# Server-side capability profile. Unknown values fail closed to `ru`.
# Keep this aligned with VITE_DEPLOYMENT_MARKET in the frontend deployment.
DEPLOYMENT_MARKET=ru

# Forwarded client IPs are ignored unless both values are explicitly configured.
# In production, use only the verified CIDR ranges of the platform proxy that
# connects directly to this service. Never set TRUSTED_PROXY_HOPS alone.
TRUSTED_PROXY_HOPS=0
TRUSTED_PROXY_CIDRS=

# Legacy cabinet photo storage remains supported during the provider migration;
# new AutoCare provider media uses the catalog media adapter.
CABINET_PHOTO_ALLOWED_HOSTS=
# Optional absolute path for legacy filesystem images. Keep the default for
# local development; use a mounted persistent volume before production launch.
CABINET_UPLOADS_DIR=uploads/cabinets

# Attachments in service requests and hidden chats.  Local filesystem storage is
# intentionally development-only. Production requires S3-compatible private
# storage and a ClamAV scanner before an object is promoted out of quarantine.
AUTOCARE_ATTACHMENT_STORAGE_PROVIDER=filesystem
AUTOCARE_ATTACHMENT_RETENTION_DAYS=365
AUTOCARE_ATTACHMENT_SIGNED_URL_TTL_SECONDS=300
AUTOCARE_ATTACHMENT_ANTIVIRUS_MODE=disabled
AUTOCARE_ATTACHMENT_CLAMAV_COMMAND=clamdscan
AUTOCARE_ATTACHMENT_SCAN_TIMEOUT_MS=30000
# AUTOCARE_ATTACHMENT_S3_ENDPOINT=https://s3.example.com
AUTOCARE_ATTACHMENT_S3_REGION=us-east-1
# AUTOCARE_ATTACHMENT_S3_BUCKET=autocare-private-attachments
# AUTOCARE_ATTACHMENT_S3_ACCESS_KEY_ID=replace-me
# AUTOCARE_ATTACHMENT_S3_SECRET_ACCESS_KEY=replace-me
AUTOCARE_ATTACHMENT_S3_FORCE_PATH_STYLE=false

# Backups are encrypted with openssl AES-256-CBC + PBKDF2. This path must point
# to a deployment-secret file, never to a value committed into the repository.
# BACKUP_ENCRYPTION_PASSWORD_FILE=/run/secrets/autocare_backup_password
BACKUP_ENCRYPTION_ITERATIONS=600000

DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=autocarehub
DATABASE_PASSWORD=autocarehub
DATABASE_NAME=autocarehub
DATABASE_POOL_SIZE=10
DATABASE_POOL_MIN=0
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_SLOW_QUERY_THRESHOLD_MS=750
# Readiness is degraded when active pool ratio or waiting requests exceed these limits.
DATABASE_MAX_ACTIVE_RATIO=0.9
DATABASE_MAX_WAITING_REQUESTS=10
# DATABASE_URL=postgres://user:pass@host:port/name?ssl=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Redis-backed rate limits fail open only for local development/tests. The
# server rejects `fail-open` in production so a Redis outage cannot bypass
# security-sensitive request limits across replicas.
REDIS_RATE_LIMIT_FAILURE_MODE=fail-open

JWT_ACCESS_SECRET=change-me-in-production

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-in-local-env
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_COOKIE_NAME=autocarehub_refresh_token
CSRF_TOKEN_COOKIE_NAME=autocarehub_csrf_token

# Dedicated encryption key for one-time auth secrets kept in the outbox.
# Production requires a random value of at least 32 characters.
OUTBOX_TOKEN_ENCRYPTION_KEY=replace-with-a-random-32-character-secret

# Password breach check uses HIBP-compatible k-anonymity ranges. Local defaults
# to off; production defaults to shadow. Use enforce only after provider checks
# are verified, because provider outages will reject new password writes.
BREACHED_PASSWORD_CHECK_MODE=off

# First platform owner. In production, set this to the customer/operator email.
# In development, backend logs a one-time password setup link when the account
# has no password. In production, configure email delivery before relying on it.
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_NAME=Super Admin

# Development logs email content. Production requires smtp.
MAIL_MODE=logger
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-user
SMTP_PASSWORD=change-me
MAIL_FROM=AutoCare Hub <no-reply@example.com>

OAUTH_STATE_COOKIE_NAME=autocarehub_oauth_state

GOOGLE_OAUTH_CLIENT_ID=dev-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=dev-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/oauth/google/callback

YANDEX_OAUTH_CLIENT_ID=dev-yandex-client-id
YANDEX_OAUTH_CLIENT_SECRET=dev-yandex-client-secret
YANDEX_OAUTH_REDIRECT_URI=http://localhost:4000/auth/oauth/yandex/callback
OAUTH_REQUEST_TIMEOUT_MS=5000
OAUTH_MAX_RETRIES=2

# Customer repair payment is direct between the client and provider.  Keep
AUDIT_LOG_RETENTION_DAYS=365
BOOKING_REMINDER_HOURS=24
CABINET_UPLOAD_ORPHAN_GRACE_HOURS=24
BACKGROUND_JOB_SHUTDOWN_TIMEOUT_MS=15000
BACKGROUND_JOB_CYCLE_TIMEOUT_MS=60000
BACKGROUND_JOB_PHASE_TIMEOUT_MS=15000
HEALTH_PROBE_TIMEOUT_MS=1500
AUTH_CLEANUP_BATCH_SIZE=1000
# Readiness becomes degraded when any configured outbox threshold is exceeded.
OUTBOX_MAX_PENDING=1000
OUTBOX_MAX_DEAD_LETTER=0
OUTBOX_MAX_OLDEST_AGE_MS=900000
# Optional bearer token for the private /internal/metrics endpoint.
# Leave empty to keep the endpoint disabled.
METRICS_TOKEN=
