{
  "name": "autocare-hub-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:real": "VITE_API_MODE=real VITE_API_BASE_URL=/api vite",
    "dev:full": "npm run server:db:up && npm run server:migrate && concurrently -n backend,frontend -c blue,green \"npm run server:dev\" \"npm run dev:real\"",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server ci && npm --prefix server run build",
    "server:start": "npm --prefix server run start:server",
    "server:migrate": "npm --prefix server run release:migrate",
    "server:schema:check": "npm --prefix server run schema:check",
    "server:db:up": "npm --prefix server run db:up",
    "server:db:down": "npm --prefix server run db:down",
    "server:db:ps": "npm --prefix server run db:ps",
    "build": "tsc -b && vite build",
    "test:server:unit": "npm --prefix server run test:unit",
    "test:migration-check": "node --test scripts/check-migration-order.test.mjs",
    "check:migration-inventory": "node scripts/check-migration-inventory.mjs",
    "check:render-production-config": "node scripts/check-render-production-config.mjs",
    "test:integration-prerequisites": "node --test scripts/check-integration-prerequisites.test.mjs",
    "check:integration-prerequisites": "node scripts/check-integration-prerequisites.mjs",
    "check:mvp-readiness": "node scripts/check-mvp-readiness.mjs",
    "quality:backend": "npm run test:migration-check && npm run check:migration-inventory && npm run test:integration-prerequisites && npm run check:render-production-config && npm run check:api-contract && npm run check:api-parity && npm run check:openapi-shape && npm run check:openapi-structure && npm --prefix server run check:migrations && npm --prefix server run test:tooling && npm --prefix server run test:unit && npm --prefix server run build",
    "check:api-contract": "node scripts/check-api-contract.mjs",
    "check:api-parity": "node scripts/check-api-parity.mjs",
    "check:security-headers": "node scripts/check-security-headers.mjs",
    "check:bundle-splitting": "node scripts/check-bundle-splitting.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "check:interaction-contract": "node scripts/check-interaction-state-contract.mjs",
    "check:pwa-update": "node scripts/check-pwa-update-contract.mjs",
    "check:api-runtime-boundaries": "node scripts/check-api-runtime-boundaries.mjs",
    "check:openapi-shape": "node scripts/check-openapi-shape.mjs",
    "check:openapi-structure": "node scripts/check-openapi-structure.mjs",
    "test:openapi-structure": "node --test scripts/check-openapi-structure.test.mjs",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "check:e2e:browser": "node scripts/check-playwright-browser.mjs",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:real": "npm --prefix server run demo:reset && npm --prefix server run demo:seed && playwright test -c playwright.real.config.ts",
    "test:e2e:pwa": "playwright test -c playwright.pwa.config.ts",
    "test:e2e:visual": "playwright test -c playwright.visual.config.ts",
    "test:e2e:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/vite": "^4.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.5",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.75.0",
    "react-intersection-observer": "^10.0.3",
    "react-redux": "^9.2.0",
    "react-router": "^7.14.2",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.18.0",
    "msw": "^2.14.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
