@startuml
!include _style.puml
title Основные данные — выбранные ключи и связи
left to right direction
entity "User" as User {
  * id : uuid
  --
  role / status / tokenVersion
  nameBinding / phoneBinding : HMAC?
  avatarUrl / communityDisplayName / preferredCity : encrypted
  secondary bindings : HMAC?
}
entity "UserSession" as Session {
  * id : uuid
  userId / expiresAt
}
entity "Provider" as Provider {
  * id : uuid
  ownerId : legacy compatibility
  trustReassessedAt : successful scan?
  trustReassessmentAttemptedAt : queue order?
}
entity "ProviderMembership" as Membership {
  * id : uuid
  userId / providerId
  locationId : nullable
  role / status
}
entity "ServiceLocation" as Location {
  * id : uuid
  providerId / marketId
  timezone / schedule / capacity
}
entity "ServiceDefinition" as Definition {
  * id : uuid
  slug / comparison attributes
}
entity "ServiceOffering" as Offering {
  * id : uuid
  locationId / definitionId
  bookingMode / price / duration
}
entity "ServiceRequest" as Request {
  * id : uuid
  clientId / providerId / locationId
  definitionId / offeringId?
  status / historical snapshots
  encrypted bookingSnapshot / binding : HMAC?
  encrypted acceptedQuoteSnapshot / binding : HMAC?
  encrypted estimateSnapshot / binding : HMAC?
  encrypted contactSnapshot / binding : HMAC?
  encrypted vehicleSnapshot / binding : HMAC?
  encrypted note / binding : HMAC?
  encrypted outcome reasons / note : HMAC?
  outcome bindings : HMAC?
}
entity "ClientVehicle" as Vehicle {
  * id : uuid
  userId : owner UUID
  encrypted VIN / plate / internal number / image URL
  four companion bindings : HMAC?
}
entity "Booking" as LegacyBooking {
  * id : uuid
  clientId / cabinetId / serviceId
  status / date / time
  encrypted comment / cancellationReason / ownerNote
  three companion bindings : HMAC?
}
entity "BookingStatusHistory" as BookingHistory {
  * id : uuid
  bookingId / status / changedById?
  encrypted reason / reasonBinding : HMAC?
}
entity "BookingRescheduleRequest" as BookingReschedule {
  * id : uuid
  bookingId / requestedById / resolvedById?
  status / resolutionReason : encrypted?
  resolutionReasonBinding : HMAC?
}
entity "AutoCareRescheduleRequest" as AutoCareReschedule {
  * id : uuid
  requestId / requestedById / resolvedById?
  status / proposedAt
  encrypted reason / resolutionReason
  two companion bindings : HMAC?
}
entity "ServiceQuote" as Quote {
  * id : uuid
  requestId / version / status
  amountMinor / currencyCode
  encrypted snapshot / snapshotBinding : HMAC?
}
entity "ChatThread" as Thread {
  * id : uuid
  requestId? / providerId? / clientId?
  type / status
  encrypted subject / subjectBinding : HMAC?
}
entity "ChatReport" as ChatReport {
  * id : uuid
  threadId / reporterId
  encrypted description / resolutionReason
  encrypted assignmentReason / extensionReason
  four companion bindings : HMAC?
}
entity "ChatBlock" as ChatBlock {
  * id : uuid
  threadId / blockerId / blockedUserId
  encrypted reason / reasonBinding : HMAC?
}
entity "ServiceMessage" as Message {
  * id : uuid
  requestId? / threadId? / senderId
  encrypted body / offer
  bodyBinding : HMAC?
  offerBinding : HMAC?
}
entity "ServiceAttachment" as Attachment {
  * id : uuid
  requestId? / threadId? / uploadedById
  private storage object key
}
entity "AutomotiveReview" as Review {
  * id : uuid
  providerId / clientId? / serviceRequestId?
  status / revision allowance
  contentRevision : integer
}
entity "TrustEvidence" as Evidence {
  * id : uuid
  providerId / kind / status
  reference : encrypted text
  referenceIndex : HMAC blind index
  notes : encrypted text
  referenceBinding / notesBinding : HMAC?
  reviewRevision : integer?
}
entity "ProviderChangeRequest" as ProviderChange {
  * id : uuid
  providerId / requestedById / kind
  payload / reviewReason : encrypted
  payloadBinding / reviewReasonBinding : HMAC?
}
entity "Appeal" as Appeal {
  * id : uuid
  subject / subjectId / submittedById / providerId?
  reason / decisionReason : encrypted text
  reasonBinding / decisionReasonBinding : HMAC?
}
entity "CatalogGapRequest" as CatalogGap {
  * id : uuid
  requestedById / providerId?
  proposedSlug / categorySlug / priceType
  labels / comparisonAttributes / rationale / reviewReason : encrypted
  four companion bindings : HMAC?
}
entity "RepairEvent" as RepairEvent {
  * id : uuid
  requestId / eventType / actorId?
  title / notes / metadata : encrypted
  titleBinding / notesBinding / metadataBinding : HMAC?
}
entity "BroadcastRequest" as BroadcastRequest {
  * id : uuid
  clientId / serviceDefinitionId / marketId?
  issueDescription / vehicleSnapshot : encrypted
  issueDescriptionBinding / vehicleSnapshotBinding : HMAC?
}
entity "BroadcastOffer" as BroadcastOffer {
  * id : uuid
  broadcastRequestId / providerId / locationId
  offerSnapshot : encrypted
  offerSnapshotBinding : HMAC?
}
entity "GuaranteeClaim" as Claim {
  * id : uuid
  requestId / clientId / providerId
  caseKey : unique canonical request?
  claimType / status
  summary / resolution : encrypted
  summaryBinding / resolutionBinding : HMAC?
}
entity "BonusAccount" as Account {
  * id : uuid
  clientId / providerId
  cached balance projection
}
entity "BonusLedger" as Ledger {
  * id : uuid
  accountId / requestId?
  type / points / idempotencyKey
  expiresAt / createdAt
}
entity "OutboxEvent" as Outbox {
  * id : uuid
  type / payload / idempotencyKey
  status / attempts / availableAt
}
entity "EmailBindingCheckpoint" as EmailCheckpoint {
  * name : users / invitations
  --
  afterId : uuid?
  processed : bigint
}
entity "OutboxBindingCheckpoint" as OutboxCheckpoint {
  * name : outbox_events
  --
  afterId : uuid?
  processed : bigint
}
entity "OAuthBindingCheckpoint" as OAuthCheckpoint {
