  afterId : uuid?
  processed : bigint
}
entity "MessageOfferBindingCheckpoint" as OfferCheckpoint {
  * name : autocare_service_messages
  --
  afterId : uuid?
  processed : bigint
}
entity "ChatSubjectBindingCheckpoint" as ChatCheckpoint {
  * name : autocare_chat_threads
  --
  afterId : uuid?
  processed : bigint
}
entity "BookingSnapshotBindingCheckpoint" as BookingCheckpoint {
  * name : autocare_service_requests
  --
  afterId : uuid?
  processed : bigint
}
entity "AcceptedQuoteBindingCheckpoint" as AcceptedQuoteCheckpoint {
  * name : autocare_service_requests
  --
  afterId : uuid?
  processed : bigint
}
entity "EstimateSnapshotBindingCheckpoint" as EstimateCheckpoint {
  * name : autocare_service_requests
  --
  afterId : uuid?
  processed : bigint
}
entity "ContactSnapshotBindingCheckpoint" as ContactCheckpoint {
  * name : autocare_service_requests
  --
  afterId : uuid?
  processed : bigint
}
entity "UserSecondaryBindingCheckpoint" as SecondaryCheckpoint {
  * name : users
  afterId : uuid?
  processed : bigint
}
entity "ClientVehicleBindingCheckpoint" as VehicleCheckpoint {
  * name : client_vehicles
  afterId : uuid?
  processed : bigint
}
entity "BookingStatusReasonBindingCheckpoint" as HistoryCheckpoint {
  * name : booking_status_history
  afterId : uuid?
  processed : bigint
}
entity "BookingTextBindingCheckpoint" as BookingTextCheckpoint {
  * name : bookings
  afterId : uuid?
  processed : bigint
}
entity "BookingRescheduleReasonBindingCheckpoint" as BookingRescheduleCheckpoint {
  * name : booking_reschedule_requests
  afterId : uuid?
  processed : bigint
}
entity "AutoCareRescheduleTextBindingCheckpoint" as AutoCareRescheduleCheckpoint {
