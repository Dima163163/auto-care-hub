@startuml
!include _style.puml
title Основные данные — выбранные ключи и связи
left to right direction
entity "User" as User {
  * id : uuid
  --
  role / status / tokenVersion
  nameBinding / phoneBinding : HMAC?
}
entity "UserSession" as Session {
  * id : uuid
  userId / expiresAt
}
entity "Provider" as Provider {
  * id : uuid
  ownerId : legacy compatibility
  trustReassessedAt : successful scan?
  trustReassessmentAttemptedAt : queue order?
}
entity "ProviderMembership" as Membership {
  * id : uuid
  userId / providerId
  locationId : nullable
  role / status
}
entity "ServiceLocation" as Location {
  * id : uuid
  providerId / marketId
  timezone / schedule / capacity
}
entity "ServiceDefinition" as Definition {
  * id : uuid
  slug / comparison attributes
}
entity "ServiceOffering" as Offering {
  * id : uuid
  locationId / definitionId
  bookingMode / price / duration
}
entity "ServiceRequest" as Request {
  * id : uuid
  clientId / providerId / locationId
  definitionId / offeringId?
  status / historical snapshots
  encrypted bookingSnapshot / binding : HMAC?
  encrypted acceptedQuoteSnapshot / binding : HMAC?
}
entity "ServiceQuote" as Quote {
  * id : uuid
  requestId / version / status
  amountMinor / currencyCode
}
entity "ChatThread" as Thread {
  * id : uuid
  requestId? / providerId? / clientId?
  type / status
  encrypted subject / subjectBinding : HMAC?
}
entity "ServiceMessage" as Message {
  * id : uuid
  requestId? / threadId? / senderId
  encrypted body / offer
  bodyBinding : HMAC?
  offerBinding : HMAC?
}
entity "ServiceAttachment" as Attachment {
  * id : uuid
  requestId? / threadId? / uploadedById
  private storage object key
}
entity "AutomotiveReview" as Review {
  * id : uuid
  providerId / clientId? / serviceRequestId?
  status / revision allowance
  contentRevision : integer
}
entity "TrustEvidence" as Evidence {
  * id : uuid
  providerId / kind / status
  reference : encrypted text
  referenceIndex : HMAC blind index
  reviewRevision : integer?
}
entity "GuaranteeClaim" as Claim {
  * id : uuid
  requestId / clientId / providerId
  caseKey : unique canonical request?
  status / resolution
}
entity "BonusAccount" as Account {
  * id : uuid
  clientId / providerId
  cached balance projection
}
entity "BonusLedger" as Ledger {
  * id : uuid
  accountId / requestId?
  type / points / idempotencyKey
  expiresAt / createdAt
}
entity "OutboxEvent" as Outbox {
  * id : uuid
  type / payload / idempotencyKey
  status / attempts / availableAt
}
entity "EmailBindingCheckpoint" as EmailCheckpoint {
  * name : users / invitations
  --
  afterId : uuid?
  processed : bigint
}
entity "OutboxBindingCheckpoint" as OutboxCheckpoint {
  * name : outbox_events
  --
  afterId : uuid?
  processed : bigint
}
entity "OAuthBindingCheckpoint" as OAuthCheckpoint {
  * name : oauth_identities
  --
  afterId : uuid?
  processed : bigint
}
entity "UserProfileBindingCheckpoint" as ProfileCheckpoint {
  * name : users
  --
  afterId : uuid?
  processed : bigint
}
entity "MessageBodyBindingCheckpoint" as MessageCheckpoint {
  * name : autocare_service_messages
  --
  afterId : uuid?
  processed : bigint
}
entity "MessageOfferBindingCheckpoint" as OfferCheckpoint {
  * name : autocare_service_messages
  --
  afterId : uuid?
  processed : bigint
}
entity "ChatSubjectBindingCheckpoint" as ChatCheckpoint {
  * name : autocare_chat_threads
  --
  afterId : uuid?
  processed : bigint
}
entity "BookingSnapshotBindingCheckpoint" as BookingCheckpoint {
  * name : autocare_service_requests
  --
  afterId : uuid?
  processed : bigint
}
entity "AcceptedQuoteBindingCheckpoint" as AcceptedQuoteCheckpoint {
  * name : autocare_service_requests
  --
  afterId : uuid?
  processed : bigint
}
User ||--o{ Session
User ||--o{ Membership
Provider ||--o{ Membership
Location |o--o{ Membership : optional scope
Provider ||--o{ Location
Location ||--o{ Offering
Definition ||--o{ Offering
User ||--o{ Request : client
Location ||--o{ Request
Offering |o--o{ Request
Request ||--o{ Quote
Request |o--o{ Thread
Thread |o--o{ Message
Thread |o--o{ Attachment
Request |o--o{ Attachment
Request |o--o{ Review
Provider ||--o{ Review
Provider ||--o{ Evidence
Review ..> Evidence : logical encrypted reference
Request ||--o{ Claim
Provider ||--o{ Account
User ||--o{ Account
Account ||--o{ Ledger
Outbox ..> OutboxCheckpoint : bounded keyset progress
OAuthCheckpoint ..> User : identity owner scope
ProfileCheckpoint ..> User : bounded name / phone backfill
MessageCheckpoint ..> Message : bounded body backfill
OfferCheckpoint ..> Message : bounded offer backfill
ChatCheckpoint ..> Thread : bounded subject backfill
BookingCheckpoint ..> Request : bounded booking backfill
AcceptedQuoteCheckpoint ..> Request : bounded accepted quote backfill
note bottom of Ledger
  U18: positive earn/adjustment/refund entries form lots.
  Redemption consumes earliest expiry first;
  expiry applies only to the unspent amount of its lot.
  Refund is a new non-expiring credit.
end note
note bottom of Claim
  U19: one canonical case per request.
  Historic duplicates retain null caseKey;
  only the canonical case affects trust.
  Allegations never count as proven violations.
end note
note bottom of Provider
  N25: successful trust scans advance both timestamps,
  failed scans advance only attemptedAt.
  A policy change clears both watermarks.
end note
note bottom of Evidence
  U16: exact lookup uses referenceIndex;
  reference remains randomly encrypted.
  Migration backfills existing references.
end note
note bottom of Review
  N24: edit locks the review row, consumes allowance,
  increments contentRevision and queues matching evidence.
  Older pending evidence becomes superseded;
  moderation checks the matching revision under row lock.
  N21: admin status counts aggregate the full table;
  anomaly signals and calibration use the latest 1000 reviews.
end note
Request ..> Outbox : effects; payload association
EmailCheckpoint ..> User : bounded email backfill
EmailCheckpoint ..> Provider : invitation provider scope
note bottom of EmailCheckpoint
  U02: compare-write and checkpoint commit together.
  Verify full row/owner MAC coverage before strict reads.
  Production backfill and restore remain unverified.
end note
note bottom of OAuthCheckpoint
  U02: bounded compare-write and checkpoint commit together.
  Verify subject MAC by identity/user UUID and provider.
  Real KMS/restore and strict cutover remain unverified.
end note
note bottom of ProfileCheckpoint
  U02: name and non-null phone HMAC bind plaintext to user UUID.
  Compare-write and checkpoint commit together; full verify precedes
  opt-in strict read. Real KMS/restore remains unverified.
end note
note bottom of MessageCheckpoint
  U02: non-null body HMAC binds plaintext to message,
  request/thread and sender UUIDs and message kind.
  Compare-write and checkpoint commit together; full verify precedes
  opt-in strict read. Null body has null binding.
end note
note bottom of OfferCheckpoint
  U02: non-null offer HMAC binds decrypted JSON to message,
  request/thread and sender UUIDs and message kind.
  Compare-write and checkpoint commit together; full verify precedes
  opt-in strict read. Null offer has null binding.
end note
note bottom of ChatCheckpoint
  U02: subject HMAC binds plaintext to thread UUID,
  type and request/provider/client/creator UUIDs.
  Compare-write and checkpoint commit together; full verify precedes
  opt-in strict read. Account deletion rebinds redacted subjects.
end note
note bottom of BookingCheckpoint
  U02: booking JSON HMAC binds plaintext to request UUID,
  client/provider/location/definition UUIDs.
  Compare-write and checkpoint commit together; full verify precedes
  opt-in strict read. Account deletion clears snapshot and binding.
end note
note bottom of Evidence
  Пунктир — логическая связь, не FK.
  Reference lookup fix требует применения migration и проверки DB.
  Snapshot и FK нельзя восстанавливать из этой сокращённой карты:
  authoritative schema — entities + migrations.
end note
footer Полная schema также содержит market hierarchy / vehicles / capacity / appeals / audit
@enduml
